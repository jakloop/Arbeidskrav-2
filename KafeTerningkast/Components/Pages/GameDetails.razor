@page "/games/{id:int}"
@using KafeTerningkast.Models
@using KafeTerningkast.Services
@inject GameService GameService
@inject GameNightState GameNightState

<h1>Spilldetaljer</h1>

@if (game is null)
{
    <div class="container">
    <p>Fant ikke spillet.</p>
    <a href="/games">Tilbake til spilloversikten</a>
    </div>
}
else
{
    <h2>@game.Name</h2>
    <p>@game.Category</p>
    <p>@game.Description</p>
    <p>Antall spiller: @game.MinPlayers-@game.MaxPlayers</p>
    <p>Spilletid: @game.PlayTimeMinutes minutter</p>
    <DiceRating @bind-Value="selectedRating" />
    @if (GameNightState.ContainsGame(game.Id))
    {
        <button @onclick="() => GameNightState.RemoveGame(game)">
            Fjern fra spillekveld
        </button>
    }
    else
    {
        <button @onclick="() => GameNightState.AddGame(game)">
            Legg til i spillekveld
        </button>
    }
    <a href="/games">Tilbake til spilloversikten</a>
    
}

@code
{
    [Parameter]
    public int Id { get; set; }
    
    private int selectedRating;

    private BoardGame? game;

    protected override void OnParametersSet()
    {
        game = GameService.GetAllGames()
            .FirstOrDefault(g => g.Id == Id);

        if (game is not null)
        {
            selectedRating = game.Rating;
        }
}

}
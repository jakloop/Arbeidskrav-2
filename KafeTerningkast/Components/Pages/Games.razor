@page "/games"
@using KafeTerningkast.Models
@using KafeTerningkast.Services
@inject GameService GameService

<PageTitle>Games</PageTitle>

<h1>Brettspill</h1>

<p>Vårt utvalg av brettspill</p>

<input type="text"
       class ="form-control"
       placeholder="Søk etter spill..."
       @bind="searchText"
       @bind:event="oninput" />

<input type="number"
       placeholder="Number of players"
       @bind="playerCount"
       @bind:event="oninput"
       min="1"
       max="8"/>

<div class="filter-matches">Antall treff: @FilteredGames.Count</div>

<FindRandomGame Games="_games"
                OnGameSelected="SetSelectedGame"/>

@if (selectedGame is not null &&
     FilteredGames.Any(g => g.Id == selectedGame.Id))
{
    <EnhanceGameCard Game="selectedGame" />
}
@foreach (var game in FilteredGames.Where(
                  g => selectedGame is null || g.Id != selectedGame.Id))
    {
        <GameCard Game="game"/>
    }


@code {

    private List<BoardGame> _games = new();
    private string searchText = "";
    private int? playerCount = null;

    private BoardGame? selectedGame;

    private void SetSelectedGame(BoardGame game)
    {
        selectedGame = game;
    }

    private List<BoardGame> FilteredGames =>
        _games.Where(g => g.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                         && (playerCount == null || (g.MinPlayers <= playerCount && g.MaxPlayers >= playerCount)))
            .ToList();
    
    protected override void OnInitialized()
    {
        _games = GameService.GetAllGames();
    }
};
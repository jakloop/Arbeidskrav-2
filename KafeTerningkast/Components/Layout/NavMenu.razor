@using KafeTerningkast.Services
@inject GameNightState GameNightState
@implements IDisposable


<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">KafeTerningkast</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler"/>

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Hjem
            </NavLink>
        </div>

        
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="games">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Brettspill
            </NavLink>
        </div>
        
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="game-night">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Spillkveld (@GameNightState.Count)
            </NavLink>
        </div>
        

        
    </nav>
</div>

@code {
    // these functions watches whether GameNightState.Count is changed and updates
    protected override void OnInitialized()
    {
        GameNightState.OnChange += HandleStateChanged;
    }

    private void HandleStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        GameNightState.OnChange -= HandleStateChanged;
    }
}
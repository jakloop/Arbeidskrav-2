@using KafeTerningkast.Models

<button class="btn btn-primary" @onclick="FindARandomGame">
    Finn et tilfeldig spill
</button>

@code {
[Parameter]
public List<BoardGame> Games { get; set; } = new();

[Parameter]
public EventCallback<BoardGame> OnGameSelected { get; set; }


private async Task FindARandomGame()
{
if (Games.Count == 0)
{
return;
}

int randomIndex = Random.Shared.Next(0, Games.Count);
BoardGame selectedGame = Games[randomIndex];

await OnGameSelected.InvokeAsync(selectedGame);
}
}

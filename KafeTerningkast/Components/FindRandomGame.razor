@using KafeTerningkast.Models

<button class="btn btn-primary" @onclick="FindARandomGame">
    Finn et tilfeldig spill
</button>

@if (selectedGame is not null)
{
<button class="btn btn-secondary" @onclick="ClearGame">
        Fjern spill
</button>

<EnhanceGameCard Game="selectedGame" />

}

@code {
[Parameter]
public List<BoardGame> Games { get; set; } = new();

private BoardGame? selectedGame;

private void ClearGame()
{
selectedGame = null;
}

private void FindARandomGame()
{
if (Games.Count == 0)
{
return;
}

int randomIndex = Random.Shared.Next(0, Games.Count);
selectedGame = Games[randomIndex];
}
}

@using KafeTerningkast.Models

<div class="card m-3 col" style="max-width: 540px;">
    <div class="row g-0">
        <div class="col-md-4">
            <img src="/images/bikesprite2.png"
                 class="img-fluid rounded-start"
                 style="width: 100px;"
                 alt="Game illustration">
        </div>
        <div class="col-md-8">
            <div class="card-body">
                <h5 class="card-title">@Game.Name</h5>
                <p>Kategori: @Game.Category</p>
                <p class="card-text">@Game.Description</p>
                <p> Antall spillere: 
                    @if (Game.MinPlayers == Game.MaxPlayers)
                    {
                        @Game.MinPlayers
                    }
                    else
                    {
                        @($"{Game.MinPlayers} - {Game.MaxPlayers}")
                    }
                </p>
                <p>Spillengde: @Game.PlayTimeMinutes min</p>
                <DiceRating Value="Game.Rating" ReadOnly="true" />
                <a class="btn btn-primary" href="@($"/games/{Game.Id}")">
                    Se detaljer
                </a>
                <button class="btn btn-primary"
                        @onclick="() => OnGameNightSelected.InvokeAsync(Game)">
                    Legg til i din spillkveld
                </button>
            </div>
        </div>
    </div>
</div>

@code
{
    // gamecard can receive a value of this property
    [Parameter]
    public BoardGame Game { get; set; } = default!;
    
    [Parameter]
    public EventCallback<BoardGame> OnGameNightSelected { get; set; }
}
